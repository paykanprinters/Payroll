# Copy to .env.e2e and source before running `pnpm e2e`.
# Admin account (required for critical-path suite).
E2E_EMAIL=admin@example.com
E2E_PASSWORD=change-me

# Manager console smoke (optional — skips Manager project if unset).
# E2E_MANAGER_EMAIL=manager@example.com
# E2E_MANAGER_PASSWORD=change-me

# Staff portal smoke (optional — skips Staff project if unset).
# E2E_STAFF_EMAIL=staff@example.com
# E2E_STAFF_PASSWORD=change-me

# Optional: override the base URL if not running the local dev server on 8080.
# E2E_BASE_URL=http://127.0.0.1:8080

# GitHub Actions: map the same values to repository secrets (see docs/E2E_CI.md).
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are also required in CI for the dev server.
