# Copy to .env.e2e and source before running `pnpm e2e`.
# Credentials for an Admin account used to authenticate the Playwright suite.
E2E_EMAIL=admin@example.com
E2E_PASSWORD=change-me

# Optional: override the base URL if not running the local dev server on 8080.
# E2E_BASE_URL=http://127.0.0.1:8080
