{
  "name": "kan-printers-payroll",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-vercel-env.mjs && vite build",
    "build:web": "vite build",
    "build:dev": "vite build --mode development",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "cap:build:android": "node scripts/build-staff-apk.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "gen:acb-sample": "node scripts/gen-acb-sample.mjs",
    "check:tax-tables": "vitest run src/lib/sars-tax-tables-coverage.test.ts src/lib/sars-tax-tables.test.ts",
    "check:sars-compliance": "vitest run src/lib/payroll-calculations/sars-regression.test.ts src/lib/payroll-calculations/golden-master.test.ts src/lib/tax-tables-validation.test.ts"
  },
