# Copy to android/keystore.properties and fill in real values.
# NEVER commit keystore.properties or the keystore file itself.
#
# Generate a keystore (one time):
#   keytool -genkeypair -v -storetype PKCS12 -keystore android/staff-release.keystore \
#     -alias kan-staff -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to the android/ directory.

storeFile=staff-release.keystore
storePassword=change-me
keyAlias=kan-staff
keyPassword=change-me
