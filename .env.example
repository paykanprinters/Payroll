# Copy to .env for local dev. On Vercel, add the same keys under
# Project → Settings → Environment Variables (Production + Preview), then redeploy.
#
# Vite inlines VITE_* at build time — env changes require a new deployment.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Production portal URLs (required on Vercel for cross-portal redirects)
# VITE_ADMIN_PORTAL_URL="https://payroll.kanprinters.co.za"
# VITE_STAFF_PORTAL_URL="https://payroll.kanprinters.co.za"

# Optional — Kan Printers defaults are baked in; override only if needed
# VITE_COMPANY_NAME="Kan Printers & Promo"
# VITE_COMPANY_SHORT_NAME="Kan Printers"
# VITE_COMPANY_TAGLINE="KAN DO IT — since 2000"
# VITE_COMPANY_LOGO_URL="/brand/kanprinters_horizontal_color.png"
# VITE_COMPANY_LOGO_URL_DARK="/brand/kanprinters_horizontal_dark.png"
# VITE_COMPANY_ICON_URL="/brand/kanprinters_icon_color.png"
# VITE_PORTAL="admin"

# Supabase Edge Functions (Dashboard → Edge Functions → Secrets, NOT Vercel)
# ALLOWED_ORIGINS="https://payroll.kanprinters.co.za,https://payroll-beta-orcin.vercel.app"
# ALLOW_SEED=false
# Required for fetch-biometric-logs (fail-closed when empty). Comma-separated hostnames only.
# BIOMETRIC_ALLOWED_HOSTS="pbx.compu-e.co.za"

# Supabase Auth (Dashboard → Authentication → URL Configuration)
# Site URL: https://payroll.kanprinters.co.za
# Redirect URLs: https://payroll.kanprinters.co.za/**

# Staff Android app (Capacitor) — optional override for local device testing
# STAFF_APP_SERVER_URL="https://payroll.kanprinters.co.za/staff/login"
# STAFF_APP_SERVER_URL="http://10.0.2.2:8080/staff/login"
